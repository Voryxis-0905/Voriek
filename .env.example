# Optional default provider configuration. You can also configure a provider in Settings.
# Never commit a real API key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Optional: place local worlds, saves, and runtime configuration outside the repository.
# STORY_ENGINE_DATA_DIR=C:/path/to/voriek-data

# Optional: comma-separated browser origins for a non-local UI deployment.
# STORY_ENGINE_ALLOWED_ORIGINS=https://your-voriek.example
